# SMLT Leaderboard Environment Variables

# Supabase PostgreSQL connection string
# Найти в: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.xxxxx:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# JWT secret key (генерация: openssl rand -base64 64)
JWT_SECRET=your-super-secret-jwt-key-here

# Пароль хоста.
# Рекомендуется: bcrypt-хеш пароля вместо открытого текста (cost 12).
# ВАЖНО: значение в ОДИНАРНЫХ кавычках, иначе godotenv раскроет $-символы как переменные
# HOST_PASSWORD_HASH='$2a$12$...'
# Либо открытый текст (будет захеширован bcrypt при запуске):
HOST_PASSWORD=your-secure-password-here

# Стоимость bcrypt, если задан HOST_PASSWORD в открытом виде (4-31, по умолчанию 12)
BCRYPT_COST=12

# CORS origin
ALLOWED_ORIGIN=https://smlt.lol

# Адрес сервера
LISTEN_ADDR=:8080
